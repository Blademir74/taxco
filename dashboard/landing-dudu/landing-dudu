< !DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Obdulia "Dudú" Naranjo Cabrera — Distrito XXI Guerrero</title><meta name="description" content="Participación ciudadana, agenda social y actividades comunitarias en Taxco, Pilcaya y Tetipac. Distrito XXI Guerrero."><meta name="robots" content="index, follow"><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"><style>:root {
    --verde: #1a4a2e;
    --verde-medio: #2d6e47;
    --verde-claro: #4a9e6b;
    --dorado: #c8a951;
    --dorado-claro: #e8c97a;
    --crema: #f8f4ee;
    --blanco: #ffffff;
    --gris: #6b7280;
    --gris-claro: #f1f0ed;
    --texto: #1a1a1a;
    --radio: 12px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', sans-serif;
    color: var(--texto);
    background: var(--crema);
    overflow-x: hidden;
}

/* NAV */
nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(26, 74, 46, 0.97);
    backdrop-filter: blur(12px);
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(200, 169, 81, 0.3);
}

.nav-logo {
    font-family: 'Playfair Display', serif;
    color: var(--dorado);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.nav-logo span {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 300;
}

.nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
}

.nav-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: color 0.2s;
}

.nav-links a:hover {
    color: var(--dorado);
}

.nav-cta {
    background: var(--dorado);
    color: var(--verde) !important;
    padding: 8px 20px;
    border-radius: 50px;
    font-weight: 600 !important;
}

.nav-cta:hover {
    background: var(--dorado-claro) !important;
    color: var(--verde) !important;
}

/* HERO */
.hero {
    min-height: 100vh;
    background:
        radial-gradient(ellipse at 70% 50%, rgba(74, 158, 107, 0.15) 0%, transparent 60%),
        radial-gradient(ellipse at 20% 80%, rgba(200, 169, 81, 0.08) 0%, transparent 50%),
        linear-gradient(160deg, #0d2b1a 0%, #1a4a2e 40%, #1e3a28 100%);
    display: flex;
    align-items: center;
    padding: 120px 40px 80px;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
        radial-gradient(circle at 1px 1px, rgba(200, 169, 81, 0.12) 1px, transparent 0);
    background-size: 40px 40px;
    pointer-events: none;
}

.hero-content {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 80px;
    align-items: center;
}

.hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(200, 169, 81, 0.15);
    border: 1px solid rgba(200, 169, 81, 0.4);
    color: var(--dorado);
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 28px;
    animation: fadeUp 0.8s ease both;
}

.hero-tag::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--dorado);
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.5;
        transform: scale(1.4);
    }
}

h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 900;
    color: var(--blanco);
    line-height: 1.1;
    margin-bottom: 12px;
    animation: fadeUp 0.8s 0.1s ease both;
}

h1 em {
    font-style: italic;
    color: var(--dorado);
}

.hero-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 520px;
    font-weight: 300;
    animation: fadeUp 0.8s 0.2s ease both;
}

.hero-btns {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    animation: fadeUp 0.8s 0.3s ease both;
}

.btn-primary {
    background: var(--dorado);
    color: var(--verde);
    padding: 14px 28px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-primary:hover {
    background: var(--dorado-claro);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(200, 169, 81, 0.35);
}

.btn-outline {
    background: transparent;
    color: var(--blanco);
    padding: 14px 28px;
    border-radius: 50px;
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-outline:hover {
    border-color: var(--dorado);
    color: var(--dorado);
    transform: translateY(-2px);
}

.hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 52px;
    animation: fadeUp 0.8s 0.4s ease both;
}

.stat {}

.stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--dorado);
    display: block;
}

.stat-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

/* Tarjeta perfil hero */
.hero-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(200, 169, 81, 0.25);
    border-radius: 24px;
    padding: 40px 32px;
    backdrop-filter: blur(20px);
    animation: fadeLeft 0.9s 0.2s ease both;
    position: relative;
    overflow: hidden;
}

.hero-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--dorado), var(--verde-claro), var(--dorado));
}

.profile-avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--verde-medio), var(--dorado));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: white;
    margin-bottom: 20px;
    border: 3px solid rgba(200, 169, 81, 0.4);
}

.profile-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--blanco);
    margin-bottom: 4px;
}

.profile-nick {
    font-size: 1rem;
    color: var(--dorado);
    font-style: italic;
    margin-bottom: 16px;
}

.profile-cargo {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
    padding: 12px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    margin-bottom: 20px;
}

.profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.ptag {
    background: rgba(200, 169, 81, 0.15);
    border: 1px solid rgba(200, 169, 81, 0.3);
    color: var(--dorado-claro);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
}

.counter-live {
    margin-top: 24px;
    padding: 16px;
    background: rgba(74, 158, 107, 0.15);
    border: 1px solid rgba(74, 158, 107, 0.3);
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.counter-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--verde-claro);
    min-width: 60px;
}

.counter-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeLeft {
    from {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* SECCIONES GENERALES */
section {
    padding: 96px 40px;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

.section-tag {
    display: inline-block;
    color: var(--verde-medio);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--dorado);
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 900;
    color: var(--verde);
    line-height: 1.2;
    margin-bottom: 16px;
}

.lead {
    font-size: 1.05rem;
    color: var(--gris);
    line-height: 1.7;
    max-width: 600px;
    font-weight: 300;
}

/* QUIÉN ES */
.quien {
    background: var(--blanco);
}

.quien-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
}

.timeline {
    margin-top: 40px;
    position: relative;
    padding-left: 24px;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(180deg, var(--dorado), var(--verde-claro));
}

.tl-item {
    position: relative;
    margin-bottom: 28px;
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.5s ease;
}

.tl-item.visible {
    opacity: 1;
    transform: translateX(0);
}

.tl-item::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 6px;
    width: 10px;
    height: 10px;
    background: var(--dorado);
    border-radius: 50%;
    border: 2px solid var(--blanco);
    box-shadow: 0 0 0 2px var(--dorado);
}

.tl-year {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--dorado);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.tl-text {
    font-size: 0.95rem;
    color: var(--texto);
    line-height: 1.5;
}

.quien-valores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 32px;
}

.valor-card {
    padding: 24px 20px;
    border-radius: var(--radio);
    border: 1px solid #e5e7eb;
    transition: all 0.25s;
}

.valor-card:hover {
    border-color: var(--verde-claro);
    box-shadow: 0 4px 20px rgba(26, 74, 46, 0.08);
    transform: translateY(-3px);
}

.valor-icon {
    font-size: 1.8rem;
    margin-bottom: 10px;
}

.valor-titulo {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--verde);
    margin-bottom: 4px;
}

.valor-desc {
    font-size: 0.8rem;
    color: var(--gris);
    line-height: 1.5;
}

/* EJES */
.ejes {
    background: var(--gris-claro);
}

.ejes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
}

.eje-card {
    background: var(--blanco);
    border-radius: 20px;
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    opacity: 0;
    transform: translateY(30px);
}

.eje-card.visible {
    opacity: 1;
    transform: translateY(0);
}

.eje-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(26, 74, 46, 0.12);
}

.eje-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
}

.eje-card:nth-child(1)::before {
    background: linear-gradient(90deg, #2d6e47, #4a9e6b);
}

.eje-card:nth-child(2)::before {
    background: linear-gradient(90deg, #c8a951, #e8c97a);
}

.eje-card:nth-child(3)::before {
    background: linear-gradient(90deg, #1a4a2e, #2d6e47);
}

.eje-card:nth-child(4)::before {
    background: linear-gradient(90deg, #4a9e6b, #c8a951);
}

.eje-card:nth-child(5)::before {
    background: linear-gradient(90deg, #e8c97a, #c8a951);
}

.eje-emoji {
    font-size: 2.4rem;
    margin-bottom: 16px;
    display: block;
}

.eje-titulo {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--verde);
    margin-bottom: 10px;
}

.eje-desc {
    font-size: 0.88rem;
    color: var(--gris);
    line-height: 1.65;
}

/* TERRITORIO */
.territorio {
    background: var(--verde);
    position: relative;
    overflow: hidden;
}

.territorio::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(200, 169, 81, 0.08) 1px, transparent 0);
    background-size: 36px 36px;
}

.territorio h2 {
    color: var(--blanco);
}

.territorio .lead {
    color: rgba(255, 255, 255, 0.65);
}

.territorio .section-tag {
    color: var(--dorado);
}

.municipios-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
}

.muni-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(200, 169, 81, 0.25);
    border-radius: 20px;
    padding: 36px 28px;
    transition: all 0.3s;
}

.muni-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(200, 169, 81, 0.5);
    transform: translateY(-4px);
}

.muni-num {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    font-weight: 900;
    color: var(--dorado);
    display: block;
    margin-bottom: 4px;
}

.muni-nombre {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--blanco);
    margin-bottom: 12px;
}

.muni-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
}

.muni-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
}

.muni-tag {
    background: rgba(200, 169, 81, 0.15);
    border: 1px solid rgba(200, 169, 81, 0.3);
    color: var(--dorado-claro);
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.72rem;
}

/* FORMULARIO PARTICIPA */
.participa {
    background: var(--crema);
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: 48px;
}

.form-info h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--verde);
    margin-bottom: 16px;
}

.form-info p {
    font-size: 0.95rem;
    color: var(--gris);
    line-height: 1.7;
    margin-bottom: 20px;
}

.form-beneficios {
    list-style: none;
}

.form-beneficios li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    font-size: 0.9rem;
    color: var(--texto);
}

.form-beneficios li::before {
    content: '✓';
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    min-width: 22px;
    background: var(--verde);
    color: white;
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    margin-top: 1px;
}

.form-box {
    background: var(--blanco);
    border-radius: 24px;
    padding: 40px 36px;
    box-shadow: 0 4px 40px rgba(26, 74, 46, 0.08);
    border: 1px solid #e5e7eb;
}

.form-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--verde);
    margin-bottom: 6px;
}

.form-subtitle {
    font-size: 0.85rem;
    color: var(--gris);
    margin-bottom: 28px;
}

.field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.field {
    margin-bottom: 18px;
}

.field label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--verde);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
}

.field label span {
    color: #e63946;
}

.field input,
.field select,
.field textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    font-size: 0.9rem;
    font-family: 'DM Sans', sans-serif;
    color: var(--texto);
    background: var(--crema);
    transition: all 0.2s;
    outline: none;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    border-color: var(--verde-medio);
    background: var(--blanco);
    box-shadow: 0 0 0 3px rgba(45, 110, 71, 0.12);
}

.field input.error {
    border-color: #e63946;
}

.field .error-msg {
    color: #e63946;
    font-size: 0.75rem;
    margin-top: 4px;
    display: none;
}

.field input.error+.error-msg {
    display: block;
}

.intereses-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}

.interes-btn {
    padding: 8px 12px;
    border: 1.5px solid #e5e7eb;
    border-radius: 8px;
    background: var(--crema);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--gris);
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}

.interes-btn.active {
    border-color: var(--verde-medio);
    background: rgba(45, 110, 71, 0.08);
    color: var(--verde);
}

.checkbox-field {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 14px;
}

.checkbox-field input[type="checkbox"] {
    width: 18px;
    height: 18px;
    min-width: 18px;
    accent-color: var(--verde);
    margin-top: 2px;
}

.checkbox-field label {
    font-size: 0.8rem;
    color: var(--gris);
    line-height: 1.5;
    cursor: pointer;
}

.checkbox-field label a {
    color: var(--verde);
}

.btn-submit {
    width: 100%;
    background: var(--verde);
    color: var(--blanco);
    padding: 16px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: all 0.25s;
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.btn-submit:hover {
    background: var(--verde-medio);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26, 74, 46, 0.25);
}

.btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

.success-box {
    text-align: center;
    padding: 40px 20px;
    display: none;
}

.success-icon {
    font-size: 3rem;
    margin-bottom: 16px;
}

.success-box h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--verde);
    margin-bottom: 10px;
}

.success-box p {
    font-size: 0.9rem;
    color: var(--gris);
    line-height: 1.6;
}

/* AFILIACIÓN */
.afiliacion {
    background: var(--blanco);
}

.afiliacion-box {
    max-width: 720px;
    margin: 48px auto 0;
    border: 2px solid var(--verde);
    border-radius: 24px;
    overflow: hidden;
}

.afil-header {
    background: var(--verde);
    padding: 28px 36px;
    color: var(--blanco);
}

.afil-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 6px;
}

.afil-header p {
    font-size: 0.85rem;
    opacity: 0.75;
